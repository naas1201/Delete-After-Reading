<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark theme with AAA polish -->
    <style name="Theme.NotificationThriller" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary colors -->
        <item name="colorPrimary">#90CAF9</item>
        <item name="colorPrimaryVariant">#64B5F6</item>
        <item name="colorOnPrimary">#003258</item>
        
        <!-- Secondary colors -->
        <item name="colorSecondary">#80CBC4</item>
        <item name="colorSecondaryVariant">#4DB6AC</item>
        <item name="colorOnSecondary">#00363A</item>
        
        <!-- Surface colors -->
        <item name="colorSurface">#1C1B1F</item>
        <item name="colorOnSurface">#E6E1E5</item>
        <item name="colorSurfaceVariant">#49454F</item>
        <item name="colorOnSurfaceVariant">#CAC4D0</item>
        
        <!-- Background colors -->
        <item name="android:colorBackground">#1C1B1F</item>
        <item name="android:windowBackground">#121212</item>
        
        <!-- System bars -->
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        
        <!-- Animation duration for transitions -->
        <item name="android:windowAnimationStyle">@style/WindowAnimation</item>
        
        <!-- Enable edge-to-edge -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <!-- Splash Screen theme - Full screen with no action bar -->
    <style name="Theme.SplashScreen" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
