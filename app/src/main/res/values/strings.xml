    <string name="welcome_page1_title">Welcome to The Notification Thriller</string>
    <string name="welcome_page1_description">Experience a thrilling interactive story that unfolds through mysterious messages. Your choices will shape the narrative and determine the outcome.</string>
    
    <string name="welcome_page2_title">Real-Time Storytelling</string>
    <string name="welcome_page2_description">The story happens in real-time. When a character says "wait 10 minutes," you\'ll receive their next message after exactly 10 minutes. Experience authentic pacing and suspense.</string>
    
    <string name="welcome_page3_title">Immersive Experience</string>
    <string name="welcome_page3_description">Notifications make the game feel real. You\'ll receive messages as if you\'re truly chatting with the characters. Enable notifications for the best experience.</string>
    
    <string name="welcome_page4_title">Your Choices Matter</string>
    <string name="welcome_page4_description">Make meaningful decisions that affect relationships, unlock different story paths, and lead to multiple endings. While waiting, explore character profiles and review past messages.</string>
    
